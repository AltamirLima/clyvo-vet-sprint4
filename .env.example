# Copie para .env e preencha localmente. Nunca publique o arquivo .env.
GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.1-flash-lite
PORT=3000

# Integração opcional com a API PetFlow do grupo (credencial de colaborador; peça ao Olavo).
# O backend faz o login sozinho e renova o token, que no PetFlow vale 15 minutos.
PETFLOW_API_URL=https://clyvo-vet-api-java.onrender.com
PETFLOW_EMAIL=
PETFLOW_SENHA=
# Alternativa para uma demonstração curta: um token já gerado (expira em 15 minutos).
PETFLOW_TOKEN=
